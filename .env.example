# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas no servidor. Nunca usar prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (sem barra no final). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
